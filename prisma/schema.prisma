// Prisma schema for the Mi primera canción.
// See docs/Architecture/Database_Model.md for entity documentation,
// relationships, constraints, and the reasoning behind them.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED

  @@map("campaign_status")
}

enum LeadStatus {
  REGISTERED
  MODERATION_REJECTED
  LYRICS_GENERATED
  LYRICS_APPROVED
  SONG_GENERATING
  SONG_READY
  COMPLETED
  ATTEMPTS_EXHAUSTED

  @@map("lead_status")
}

// Sprint FINAL-2 — Lyrics Generation Traceability. `STARTED` is written
// *before* the provider call and replaced by a terminal value when the
// call returns, so a crash, a timeout or a serverless invocation killed
// mid-flight leaves evidence instead of nothing. A `STARTED` row is not
// a failure: only the combination of `result = STARTED`, a null
// `completedAt` and the row's age tells a recent in-flight attempt apart
// from an interrupted one, and that judgement is made by whoever reads
// the data — never written back here automatically.
enum GenerationAttemptResult {
  STARTED
  SUCCESS
  MODERATION_REJECTED
  FAILED

  @@map("generation_attempt_result")
}

// QUEUED / GENERATING / COMPLETED / FAILED are the only valid generation
// states as of Sprint 7.5 (see PROJECT_MANIFEST.md — Architecture
// exception). `DELIVERED` remains reserved for a future email-delivery
// module (not implemented) and still collapses to `COMPLETED` on read —
// see `SongMapper`.
enum SongStatus {
  QUEUED
  GENERATING
  COMPLETED
  DELIVERED
  FAILED

  @@map("song_status")
}

// Share Tracking. The platforms a song's share link can point at — a
// closed set, and closed on purpose: the public tracking endpoint maps a
// value of this enum to a destination URL it builds itself, so there is
// no path by which a caller-supplied URL could become a redirect target.
// Adding a platform means adding a value here *and* a destination in
// `shareDestinations`, never just accepting a new string.
enum SharePlatform {
  WHATSAPP
  FACEBOOK
  X

  @@map("share_platform")
}

// Sprint v1.1 — AI Musical Direction. The parent's requested narrator
// voice for the song, selected on the lyrics generation form and
// carried through to the Mureka prompt only (see `Lyrics.voice`) —
// never sent to Claude, never affects lyrics generation.
enum Voice {
  FEMALE
  MALE

  @@map("voice")
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Campaign {
  id                  String         @id @default(uuid()) @db.Uuid
  name                String
  status              CampaignStatus @default(DRAFT)
  maximumSongs        Int
  // LEGACY as of Sprint FINAL-6 — Derived Campaign Capacity. This is a
  // historical tally of how many songs ever reached COMPLETED: it is
  // only ever incremented (by `SongCompletionService`), never
  // decremented, so it keeps counting songs that have since been
  // deleted. On 2026-09-29 it read 430 against 395 stored songs.
  //
  // It is NOT the campaign's current consumption and must not be used
  // to enforce `maximumSongs`, to report capacity, or to show a client
  // how many songs the campaign holds. All three now count
  // `songs WHERE status = 'COMPLETED'` directly — see
  // `PrismaCampaignGate.isActiveAndGenerationEnabled`.
  songsGenerated      Int            @default(0)
  startsAt            DateTime
  endsAt              DateTime
  isGenerationEnabled Boolean        @default(true)
  // Google Tag Manager container id (e.g. "GTM-XXXXXXX") — the single,
  // DB-backed global configuration setting for all external analytics
  // integrations (see PROJECT_MANIFEST.md). Nullable/empty means GTM is
  // disabled: no tracking code is ever rendered on the Landing. Never an
  // environment variable and never hardcoded — editable only from the
  // Admin panel (Configuración) and read fresh at render time.
  gtmContainerId      String?
  // Generation provider routing — the campaign's second DB-backed global
  // setting, editable only from the Admin panel (Configuración), read
  // fresh by `GenerationDispatcher` on every tick so a change takes
  // effect without a redeploy. `primaryProvider` is tried first;
  // `fallbackProvider` is tried only for the explicitly whitelisted
  // pre-generation failures (see `providerFallbackPolicy`), and `null`
  // disables fallback entirely. Deliberately plain strings, not a Prisma
  // enum: `Song.provider` is already a String carrying historical values
  // ("suno", "mureka"), and a partial enum would mean two
  // representations of the same concept. Validation lives in
  // `UpdateGenerationRoutingUseCase` (write side) and
  // `SongGenerationProviderRegistry` (read side), the same pattern
  // `gtmContainerId` uses.
  primaryProvider     String         @default("mureka")
  fallbackProvider    String?        @default("lyria")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  leads Lead[]

  @@index([status])
  @@map("campaigns")
}

model Lead {
  id                String     @id @default(uuid()) @db.Uuid
  campaignId        String     @db.Uuid
  parentName        String
  babyName          String
  babyAge           Int?
  city              String?
  email             String     @unique
  phone             String?
  remainingAttempts Int        @default(5)
  status            LeadStatus @default(REGISTERED)
  // "Resume journey by email" — a stable, cryptographically random token
  // for the emailed resume link (see `ResolveResumeTokenUseCase`).
  // Generated once at registration and never rotated; unrelated to
  // `LeadSession.token`, which is short-lived/reissuable per session.
  resumeToken       String     @unique
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  campaign           Campaign            @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  lyrics             Lyrics[]
  song               Song?
  generationAttempts GenerationAttempt[]
  sessions           LeadSession[]
  consent            Consent?
  shareEvents        ShareEvent[]

  @@index([campaignId])
  @@index([status])
  @@index([createdAt])
  @@map("leads")
}

// Privacy Consent Module. One anonymous Consent record is created the
// moment a visitor accepts the cookie/privacy banner, keyed by a
// first-party `sessionId` cookie generated at that moment — before any
// Lead exists. If the same visitor later completes registration, the
// existing row is associated with the new Lead via that same
// `sessionId` (never a second Consent row); see
// `AssociateConsentWithLeadUseCase`. `leadId` stays nullable/unique so a
// visitor who accepts but never registers still has a durable,
// standalone consent record, and a Lead can never end up linked to more
// than one Consent.
model Consent {
  id            String   @id @default(uuid()) @db.Uuid
  sessionId     String   @unique
  leadId        String?  @unique @db.Uuid
  ipAddress     String
  userAgent     String
  policyVersion String
  acceptedAt    DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@map("consents")
}

// A dedicated, opaque, DB-backed session token for the parent-facing flow
// (registration -> lyrics -> song) — deliberately separate from Lead
// itself (a session is an auth concern, not a Lead attribute) and from
// the Admin module's stateless, signed session token (this one must be
// revocable/lookupable, per GATE 6.6). The browser only ever holds the
// opaque `token`, never `leadId`.
model LeadSession {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  leadId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_sessions")
}

model Mood {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique
  description  String?
  sunoPrompt   String
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lyrics Lyrics[]
  songs  Song[]

  @@index([active])
  @@map("moods")
}

model Lyrics {
  id              String   @id @default(uuid()) @db.Uuid
  leadId          String   @db.Uuid
  moodId          String   @db.Uuid
  prompt          String
  content         String
  // Sprint v1.1 — AI Musical Direction. `parentMessage` is the parent's
  // own song description (the "Baby Context" the Mureka prompt is built
  // from at song-generation time); `musicMood`/`musicDirection` are
  // Claude's own creative interpretation, generated alongside the lyrics
  // in the same call — see `PromptBuilder`/`ResponseParser` (Claude).
  // Nullable so pre-existing Lyrics rows (created before this migration)
  // remain valid; every row created going forward always sets all three,
  // enforced by `Lyrics.create`. `voice` has a safe default for the same
  // backward-compatibility reason.
  parentMessage   String?
  musicMood       String?
  musicDirection  String?
  voice           Voice    @default(FEMALE)
  approved        Boolean  @default(false)
  rejectionReason String?
  version         Int
  createdAt       DateTime @default(now())

  lead              Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  mood              Mood               @relation(fields: [moodId], references: [id], onDelete: Restrict)
  generationAttempt GenerationAttempt?
  songs             Song[]

  @@unique([leadId, version])
  @@index([leadId])
  @@index([approved])
  @@map("lyrics")
}

// Sprint FINAL-2 — Lyrics Generation Traceability. One row per *real
// Claude call*, which is deliberately not the same thing as a lead's
// user-facing attempt:
//
// - `Lead.remainingAttempts` counts the functional attempts the parent is
//   entitled to (`MAX_LYRIC_ATTEMPTS`, 3 in this campaign — the column's
//   own `@default(5)` is a legacy default the application never uses,
//   since `CreateLeadUseCase` always sets the budget explicitly),
//   consumed by the business rules in `GenerateLyricsForLeadUseCase`.
// - `attemptNumber` here counts provider calls actually issued for the
//   lead, ever, in order. One functional attempt can spend more than one
//   of these: an over-long lyric is retried internally by
//   `ClaudeLyricsService` without costing the parent anything. Measured
//   against the current code: one call normally, two when a retry
//   succeeds, three at most (one initial call plus
//   `LYRICS_TOO_LONG_RETRY_LIMIT` = 2 retries) before it gives up.
//
// The two numbers therefore diverge by design, and neither can be
// derived from the other. `lyricsId` stays null: linking an attempt to
// the Lyrics row it produced would require the use case to write back
// after persistence, and the attempt's own outcome already answers every
// question this table exists to answer.
//
// `providerModel` records which model produced the row, so historical
// attempts stay interpretable after the pinned model changes.
model GenerationAttempt {
  id            String                  @id @default(uuid()) @db.Uuid
  leadId        String                  @db.Uuid
  lyricsId      String?                 @unique @db.Uuid
  attemptNumber Int
  result        GenerationAttemptResult
  failureReason String?
  errorCode     String?
  providerModel String?
  createdAt     DateTime                @default(now())
  completedAt   DateTime?

  lead   Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  lyrics Lyrics? @relation(fields: [lyricsId], references: [id], onDelete: SetNull)

  @@unique([leadId, attemptNumber])
  @@index([leadId])
  @@index([result])
  @@index([createdAt])
  @@map("generation_attempts")
}

// Sprint 9.1 — Generation Pipeline Refinement. Provider interaction is
// split into a submit phase (GenerationDispatcher) and a poll phase
// (GenerationPoller); these columns are what lets the poller resume
// tracking a song across separate invocations. `audioStorageKey` is the
// *only* durable reference to the generated audio — a Cloudflare R2
// object key, never a signed URL or a provider URL (both expire and
// must never be persisted; see `AudioUrlResolver`, resolved fresh at
// read time). `providerStatus`/`providerError` mirror the provider's own
// last-reported state for diagnostics; `submittedAt`/`completedAt`
// bound how long a generation was in flight.
model Song {
  id               String     @id @default(uuid()) @db.Uuid
  leadId           String     @unique @db.Uuid
  lyricsId         String     @db.Uuid
  moodId           String     @db.Uuid
  // The provider that actually generated this song, written by
  // `GenerationDispatcher` at submission time — never the currently
  // configured primary. `GenerationPoller` resolves its adapter from
  // this column, so changing the campaign's routing never redirects a
  // song that is already in flight. The default moved from the legacy
  // "suno" to "mureka" (the real provider since the pre-beta switch);
  // historical rows are untouched.
  provider         String     @default("mureka")
  // The provider's own model identifier for this generation
  // ("mureka-9", "lyria-3.5"). Nullable: rows created before this column
  // existed never recorded it.
  providerModel    String?
  providerSongId   String?
  providerTaskId   String?
  providerTraceId  String?
  providerStatus   String?
  providerError    String?
  audioStorageKey  String?
  duration         Int?
  status           SongStatus @default(QUEUED)
  submittedAt      DateTime?
  generatedAt      DateTime?
  completedAt      DateTime?
  emailedAt        DateTime?
  // The opaque token in this song's public share URL
  // (`/song/share/[shareToken]`), minted by `Song.markCompleted` from
  // `crypto.getRandomValues` — 32 bytes, hex. Deliberately its own value
  // rather than the song id, which is already exposed to the parent's
  // own browser: a public link has to be revocable without disturbing
  // anything that references the song internally, and clearing this
  // column kills the public page and nothing else.
  //
  // Nullable and unique. `null` means "no public page": not completed
  // yet, created before this column existed, or deliberately revoked.
  // The unique index is also the lookup index — the public route
  // resolves a song by this column and nothing else.
  publicShareToken String?    @unique
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  lyrics      Lyrics       @relation(fields: [lyricsId], references: [id], onDelete: Restrict)
  mood        Mood         @relation(fields: [moodId], references: [id], onDelete: Restrict)
  shareEvents ShareEvent[]

  @@index([status])
  @@index([createdAt])
  @@index([providerTaskId])
  @@map("songs")
}

// Share Tracking. One row per click on a share link in the "song ready"
// email — what the campaign team reads as "compartidos".
//
// What a row means, precisely: our tracking endpoint was reached with a
// valid share token and a known platform. It does **not** mean WhatsApp,
// Facebook or X published or sent anything — we do not control those
// platforms and never observe the outcome. It does not even mean a
// person clicked: these links live in email, and mail providers and
// corporate security scanners follow links to inspect them, so some
// rows are machines. The metric is "share attempts recorded", and the
// admin UI says so.
//
// `songId` is strictly redundant — `songs.leadId` is unique, so the lead
// already identifies the song — and is kept anyway: the family screen
// and the export both read events by lead, and carrying the song id
// keeps that a single-table read instead of a join, which matters with
// the small connection pool this deployment runs (see
// `persistence/prisma/client.ts`).
//
// Deliberately no unique constraint: every click is its own event, so a
// parent who shares twice produces two rows.
model ShareEvent {
  id          String        @id @default(uuid()) @db.Uuid
  songId      String        @db.Uuid
  leadId      String        @db.Uuid
  platform    SharePlatform
  // Recorded as data only. Derived server-side from the validated
  // platform, never read back to decide anything — least of all a
  // redirect target.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt   DateTime      @default(now())

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // Daily totals for the dashboard, per-platform breakdowns, and one
  // family's history — the three reads that exist.
  @@index([createdAt])
  @@index([platform, createdAt])
  @@index([leadId, createdAt])
  @@map("share_events")
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("admin")
  active       Boolean   @default(true)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs AuditLog[]

  @@map("admin_users")
}

// `adminId` is nullable as of Sprint 8.2 (Abuse Protection): a `null`
// actor represents a system-recorded security/abuse event (rate limit
// exceeded, invalid Turnstile token, ...) rather than an admin action —
// see `docs/Architecture/System_Architecture.md`. Every pre-existing
// admin-initiated entry still always sets `adminId`.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  adminId   String?  @db.Uuid
  action    String
  entity    String
  entityId  String?  @db.Uuid
  metadata  Json?
  createdAt DateTime @default(now())

  admin AdminUser? @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Sprint 8.2 — Abuse Protection. A generic, DB-backed sliding-window
// rate-limit event log: one row per consumed request, keyed by scope
// (e.g. "registration:ip:1.2.3.4"). No Redis/queue — see
// PROJECT_MANIFEST.md. Counting recent rows for a key within a window
// is the entire mechanism; see `RateLimitRepository`.
model RateLimitEvent {
  id        String   @id @default(uuid()) @db.Uuid
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@map("rate_limit_events")
}
